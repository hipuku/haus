  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "hipuku",
  "homepage": "https://github.com/hipuku/haus/tree/main/packages/motion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hipuku/haus.git",
    "directory": "packages/motion"
  },
  "keywords": [
    "motion",
    "animation",
    "spring",
    "linear-easing",
    "design-tokens",
    "haus"
  ],
  "type": "module",
