  "easing": {
    "enter": {
      "$type": "cubicBezier",
      "$value": [
        0.0,
        0.0,
        0.2,
        1.0
      ],
      "$description": "Elements appearing \u2014 start slow, arrive with energy"
    },
    "exit": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0.0,
        1.0,
        1.0
      ],
