{
  "name": "@hipuku/colour",
  "version": "0.1.0",
  "description": "Perceptual colour utilities: CIEDE2000 distance, WCAG contrast, OKLCH lightness scales and hue families, perceptual clustering and nearest-named-colour, with 31,900 colour names on a /names subpath.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "hipuku",
  "homepage": "https://github.com/hipuku/haus/tree/main/packages/colour#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hipuku/haus.git",
    "directory": "packages/colour"
  },
  "keywords": [
    "colour",
    "color",
    "oklch",
    "ciede2000",
    "wcag",
    "contrast",
    "perceptual",
    "design-tokens",
    "accessibility",
    "colour-names"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./names": {
      "types": "./dist/names/index.d.ts",
      "default": "./dist/names/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "chroma-js": "^3.3.0"
  },
  "devDependencies": {
    "@types/chroma-js": "^3.1.3",
    "typescript": "^5.4.5",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
