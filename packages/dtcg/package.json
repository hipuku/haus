{
  "name": "@hipuku/dtcg",
  "version": "0.1.1",
  "description": "Convert design tokens between DTCG, Figma variables, Tokens Studio and Tailwind v4, in code or with the dtcg command, with a report of what each conversion loses.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "hipuku",
  "homepage": "https://github.com/hipuku/haus/tree/main/packages/dtcg#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hipuku/haus.git",
    "directory": "packages/dtcg"
  },
  "keywords": [
    "cli",
    "design-tokens",
    "dtcg",
    "figma",
    "tailwind",
    "tokens-studio"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "dtcg": "./dist/cli/bin.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "culori": "^4.0.2"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^22.20.3",
    "typescript": "^5.4.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
