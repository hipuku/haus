{
  "name": "haus-components",
  "version": "2.1.1",
  "description": "haus design system components: 21 accessible React primitives built on haus-tokens.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "hipuku",
  "homepage": "https://github.com/hipuku/haus/tree/main/packages/components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hipuku/haus.git",
    "directory": "packages/components"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "ui",
    "accessible",
    "haus",
    "design-tokens"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "variant-sheet": "node scripts/variant-sheet.mjs",
    "figma-docs": "node scripts/figma-docs.mjs",
    "figma": "npm run variant-sheet && npm run figma-docs"
  },
  "dependencies": {
    "haus-tokens": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.4.5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0"
  }
}
