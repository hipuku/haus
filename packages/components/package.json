{
  "name": "haus-components",
  "version": "0.4.0",
  "description": "haus design system components: 12 accessible React primitives built on haus-tokens.",
  "license": "MIT",
  "author": "hipuku",
  "homepage": "https://github.com/hipuku/haus/tree/main/packages/components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hipuku/haus.git",
    "directory": "packages/components"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "ui",
    "accessible",
    "haus",
    "design-tokens"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "haus-tokens": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.4.5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  }
}
