{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist"
  },
  "include": ["src"],
  // Tests are typechecked by `tsconfig.json`, never emitted. Without this the
  // published package carries a .d.ts for every test file.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test-types.d.ts"]
}
