{
  "name": "haus-style-probe",
  "version": "0.2.1",
  "description": "Read a rendered element's design decisions: in-browser computed-style extraction plus pure, testable normalisation into typed token values.",
  "license": "MIT",
  "author": "hipuku",
  "homepage": "https://github.com/hipuku/haus/tree/main/packages/style-probe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hipuku/haus.git",
    "directory": "packages/style-probe"
  },
  "keywords": [
    "design-tokens",
    "design-systems",
    "computed-style",
    "getcomputedstyle",
    "playwright",
    "css",
    "normalisation",
    "drift"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "haus-colour-utils": "workspace:^"
  },
  "devDependencies": {
    "happy-dom": "^20.11.15",
    "tsup": "^8.5.1",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  }
}
