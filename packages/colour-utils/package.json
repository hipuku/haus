{
  "name": "haus-colour-utils",
  "version": "0.2.0",
  "description": "Perceptual colour utilities \u2014 CIEDE2000 distance, WCAG contrast, OKLCH lightness scales, and nearest-named-colour.",
  "license": "MIT",
  "author": "hipuku",
  "homepage": "https://github.com/hipuku/haus/tree/main/packages/colour-utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hipuku/haus.git",
    "directory": "packages/colour-utils"
  },
  "keywords": [
    "colour",
    "color",
    "oklch",
    "ciede2000",
    "wcag",
    "contrast",
    "perceptual",
    "design-tokens",
    "accessibility"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "chroma-js": "^3.1.2"
  },
  "devDependencies": {
    "@types/chroma-js": "^3.1.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^2.1.0"
  }
}
