{
  "name": "@hipuku/dtcg-cli",
  "version": "0.1.0",
  "description": "Convert design tokens between DTCG, Figma variables, Tokens Studio and Tailwind v4 from the command line, with a report of what each conversion loses.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "hipuku",
  "homepage": "https://github.com/hipuku/haus/tree/main/packages/dtcg-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hipuku/haus.git",
    "directory": "packages/dtcg-cli"
  },
  "keywords": [
    "design-tokens",
    "dtcg",
    "cli",
    "figma",
    "tokens-studio",
    "tailwind"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "dtcg": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hipuku/dtcg": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.4.5",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
