{
  "name": "haus",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r run build",
    "storybook": "pnpm run build && pnpm --filter storybook run storybook",
    "build-storybook": "pnpm run build && pnpm --filter storybook run build-storybook",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "^17.11.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "type": "module"
}
