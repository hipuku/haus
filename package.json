{
  "name": "haus",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r run build",
    "storybook": "pnpm run build && pnpm --filter storybook run storybook",
    "build-storybook": "pnpm run build && pnpm --filter storybook run build-storybook",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"packages/**/*.css\"",
    "lint:css:fix": "stylelint \"packages/**/*.css\" --fix",
    "test:coverage": "pnpm -r run test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "chromatic": "^18.7.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "^17.11.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.68.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "type": "module"
}
