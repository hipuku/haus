{
  "name": "haus",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "storybook": "pnpm run build && pnpm --filter storybook run storybook",
    "build-storybook": "pnpm run build && pnpm --filter storybook run build-storybook",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"packages/**/*.css\"",
    "lint:css:fix": "stylelint \"packages/**/*.css\" --fix",
    "lint:prose": "node scripts/check-punctuation.mjs",
    "lint:md": "markdownlint-cli2",
    "knip": "knip",
    "figma:check": "node scripts/figma/check.mjs",
    "figma:accept": "node scripts/figma/check.mjs --accept",
    "test:coverage": "pnpm -r run test:coverage",
    "test:scripts": "vitest run scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "chroma-js": "^3.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.7",
    "globals": "^17.13.0",
    "knip": "^5.88.1",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.10.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "tsup>esbuild": "^0.28.2",
      "zod@<4.6.6": "^4.6.6",
      "fast-uri@<3.1.9": "^3.1.9",
      "glob@>=9 <14.0.2": "^14.0.2",
      "minimatch@>=7 <11.0.1": "^11.0.8",
      "katex@<0.18.2": "^0.19.1"
    }
  },
  "type": "module"
}
