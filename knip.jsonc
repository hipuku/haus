{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // A type or helper exported for its own file's use is not dead code.
  "ignoreExportsUsedInFile": true,
  // tsup.config.ts in @hipuku/tokens reads src/brands relative to its own package,
  // which fails when knip loads it from the root. Entries are listed below instead.
  "tsup": false,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "scripts/**/*.test.mjs"],
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    // No TypeScript: JSON configs, two Prettier presets and two bin scripts.
    "packages/config": {
      "entry": ["bin/*.mjs", "prettier/*.js", "test/*.test.mjs"],
      "project": ["bin/**/*.mjs", "prettier/**/*.js", "test/**/*.mjs"],
    },
    // The library, and the dtcg command it ships as a bin.
    "packages/dtcg": {
      "entry": ["src/index.ts", "src/cli/bin.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
    },
    "packages/motion": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
    },
    "packages/tokens": {
      "entry": ["src/index.ts", "src/guard.ts", "scripts/*.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"],
    },
    "packages/components": {
      "entry": ["src/index.ts", "scripts/*.mjs", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs"],
      /* Read through CSS custom properties, never imported, and still a runtime
         dependency: the components render unstyled without it.

         Removed on 2026-11-23 and restored the same day. token-guard.test.ts
         briefly imported `@hipuku/tokens/guard`, which made the dependency real to
         knip, so the entry looked stale and knip said so. Review then pointed
         out that the export resolves to gitignored `dist`, so the test now
         imports the source by relative path and nothing references the package
         name again. The original comment was right; the entry only looked wrong
         for as long as the test was wrong. */
      "ignoreDependencies": ["@hipuku/tokens"],
    },
    // Next's file conventions are its entries. knip does not read imports out
    // of MDX, so the examples the pages import are entries in their own right.
    "apps/docs": {
      "entry": ["app/**/*.{ts,tsx}", "components/examples/*.tsx", "components/tools/*.tsx"],
      "project": ["app/**/*.{ts,tsx}", "components/**/*.{ts,tsx}", "lib/**/*.{ts,tsx}"],
      // Loaded by `@import 'tailwindcss'` in global.css, which knip does not read.
      "ignoreDependencies": ["tailwindcss"],
    },
    "apps/storybook": {
      "entry": [".storybook/*.{ts,tsx}", "stories/**/*.{ts,tsx,mdx}"],
      "project": [".storybook/**/*.{ts,tsx}", "stories/**/*.{ts,tsx}"],
    },
  },
}
