{
  // Structure only. Prettier owns wrapping and spacing, and the docs standard
  // owns voice, so the rules that overlap with either are off.
  "config": {
    "default": true,
    "MD013": false,
    "MD033": {
      "allowed_elements": ["picture", "source", "img", "br", "small", "b", "details", "summary", "kbd", "sub", "sup"],
    },
    "MD024": { "siblings_only": true },
    "MD041": false,
  },
  "globs": ["**/*.md"],
  // Skip what git ignores, so a local file kept out of the repository is not linted.
  "gitignore": true,
  "ignores": ["**/node_modules/**", "**/dist/**", "**/coverage/**", "**/storybook-static/**"],
}
